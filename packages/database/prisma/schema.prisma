// ============================================================
// FUNDAÇÃO: Tenant (Company), Usuários, Departamentos, Auth
// ============================================================
// Estratégia de multi-tenancy: shared schema + company_id em
// toda tabela de domínio + RLS no Postgres como defesa extra.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum WhatsAppProviderType {
  BAILEYS
  META_CLOUD_API
  EVOLUTION_API
  FACEBOOK_MESSENGER
  INSTAGRAM
}

enum InstanceConnectionStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  QR_PENDING
  ERROR
}

enum ConversationStatus {
  LEAD
  OPEN
  RESOLVED
}

enum ContractStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SignatureStatus {
  PENDING
  SIGNED_DIGITAL
  SIGNED_PHYSICAL
}

enum InstallationStatus {
  PENDING
  ACTIVE
  MAINTENANCE
  OFFLINE
}

enum TicketType {
  SYNC
  INSTALLATION
  BUG
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  SYSTEM
}

// [Update 2] Status de entrega — populado via webhook Meta
enum MessageDeliveryStatus {
  ACCEPTED   // Meta aceitou o envio (imediato)
  SENT       // Enviado aos servidores WhatsApp
  DELIVERED  // Entregue ao dispositivo do destinatário
  READ       // Lido pelo destinatário
  FAILED     // Falha de entrega
}

model PlatformUser {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  passwordHash          String                 @map("password_hash")
  role                  PlatformRole           @default(SUPER_ADMIN)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  platformRefreshTokens PlatformRefreshToken[]

  @@map("platform_users")
}

model PlatformRefreshToken {
  id             String       @id @default(uuid())
  platformUserId String       @map("platform_user_id")
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  tokenHash      String       @map("token_hash")
  userAgent      String?      @map("user_agent")
  ipAddress      String?      @map("ip_address")
  revokedAt      DateTime?    @map("revoked_at")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([platformUserId])
  @@map("platform_refresh_tokens")
}

model Company {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  cnpj              String?            @unique
  active            Boolean            @default(true)
  retentionDays     Int?               @map("retention_days")   // null = retain forever; T4.5
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  users             User[]
  departments       Department[]
  whatsAppInstances WhatsAppInstance[]
  rolePermissions   RolePermission[]
  workflows         Workflow[]
  contacts          Contact[]
  conversations     Conversation[]
  contracts         ClientContract[]
  installations     Installation[]
  tickets           SupportTicket[]
  templates         Template[]
  consentLogs       ConsentLog[]
  savedReplies      SavedReply[]
  automationRules   AutomationRule[]
  slaPolicies       SlaPolicy[]
  scheduledMessages ScheduledMessage[]
  campaigns         Campaign[]
  subscription      Subscription?
  usageMeters       UsageMeter[]

  @@map("companies")
}

model User {
  id                      String                   @id @default(uuid())
  companyId               String                   @map("company_id")
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                    String
  email                   String
  passwordHash            String                   @map("password_hash")
  role                    UserRole                 @default(MEMBER)
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  refreshTokens           RefreshToken[]
  userDepartments         UserDepartment[]
  userPermissionOverrides UserPermissionOverride[]
  assignedConversations   Conversation[]           @relation("AssignedConversations")
  sentMessages            Message[]                @relation("SentMessages")
  scheduledMessages       ScheduledMessage[]
  createdCampaigns        Campaign[]           @relation("CreatedCampaigns")

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model Department {
  id                  String           @id @default(uuid())
  companyId           String           @map("company_id")
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  isDefault           Boolean          @default(false) @map("is_default")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  userDepartments     UserDepartment[]
  whatsAppInstances   WhatsAppInstance[]
  workflowFallbackFor Workflow[]       @relation("WorkflowFallbackDepartment")
  workflowRules       WorkflowRule[]
  conversations       Conversation[]

  @@index([companyId])
  @@map("departments")
}

model UserDepartment {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isManager    Boolean    @default(false) @map("is_manager")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_departments")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @map("token_hash")
  familyId    String    @map("family_id")
  replacedById String?  @map("replaced_by_id")
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address")
  revokedAt   DateTime? @map("revoked_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model WhatsAppInstance {
  id                  String                    @id @default(uuid())
  companyId           String                    @map("company_id")
  company             Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  phoneNumber         String?                   @map("phone_number")
  providerType        WhatsAppProviderType      @map("provider_type")
  credentials         String?
  connectionStatus    InstanceConnectionStatus  @default(DISCONNECTED) @map("connection_status")
  qrCode              String?                   @map("qrcode")
  defaultDepartmentId String?                   @map("default_department_id")
  defaultDepartment   Department?               @relation(fields: [defaultDepartmentId], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  conversations       Conversation[]
  templates           Template[]
  campaigns           Campaign[]

  @@index([companyId])
  @@map("whatsapp_instances")
}

// ============================================================
// Contatos — clientes que entram em contato via WhatsApp
// ============================================================

model Contact {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phoneNumber     String         @map("phone_number")
  name            String?
  avatarUrl       String?        @map("avatar_url")
  notes           String?
  optOut          Boolean        @default(false) @map("opt_out")
  // T4.1 — Consent tracking
  consentGivenAt  DateTime?      @map("consent_given_at")
  consentSource   String?        @map("consent_source")   // "whatsapp_opt_in" | "form" | "agent" | "import"
  // T4.3 — Anonymization (soft erasure instead of hard delete)
  anonymizedAt        DateTime?           @map("anonymized_at")
  conversations       Conversation[]
  consentLogs         ConsentLog[]
  campaignRecipients  CampaignRecipient[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@unique([companyId, phoneNumber])
  @@index([companyId])
  @@map("contacts")
}

// ============================================================
// T4.1 — Consent audit log (LGPD Art. 7 e 9)
// Records every opt-in / opt-out event with provenance.
// ============================================================

model ConsentLog {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId   String   @map("contact_id")
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  event       String                          // "OPT_IN" | "OPT_OUT"
  source      String                          // "whatsapp_keyword" | "form" | "agent" | "import" | "api"
  ip          String?
  userAgent   String?  @map("user_agent")
  recordedBy  String?  @map("recorded_by")   // userId if done by agent
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([companyId, contactId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("consent_logs")
}

// ============================================================
// Conversas e Mensagens
// ============================================================

model Conversation {
  id            String             @id @default(uuid())
  companyId     String             @map("company_id")
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String             @map("contact_id")
  contact       Contact            @relation(fields: [contactId], references: [id])
  instanceId    String             @map("instance_id")
  instance      WhatsAppInstance   @relation(fields: [instanceId], references: [id])
  assignedToId  String?            @map("assigned_to_id")
  assignedTo    User?              @relation("AssignedConversations", fields: [assignedToId], references: [id], onDelete: SetNull)
  departmentId  String?            @map("department_id")
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status           ConversationStatus @default(OPEN)
  priority         String             @default("MEDIUM")        // LOW | MEDIUM | HIGH | URGENT (T3.5)
  tags             String[]           @default([])              // T5.2 — array de tags livres
  lastMessageAt    DateTime?          @map("last_message_at")
  botNodeId        String?            @map("bot_node_id")
  windowExpiresAt  DateTime?          @map("window_expires_at")
  unreadCount      Int                @default(0) @map("unread_count")
  // T6.3 — SLA tracking
  firstResponseAt  DateTime?          @map("first_response_at")   // quando agente respondeu pela 1ª vez
  slaBreachedAt    DateTime?          @map("sla_breached_at")     // quando o SLA foi violado (null = dentro do prazo)
  // CSAT — nota de 1 a 5 registrada pelo atendente após resolução
  csatScore        Int?               @map("csat_score")
  messages         Message[]
  scheduledMessages ScheduledMessage[]
  aiMeta           AiConversationMeta?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, priority])
  @@index([contactId])
  @@index([instanceId])
  @@map("conversations")
}

model Message {
  id                String           @id @default(uuid())
  conversationId    String           @map("conversation_id")
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  content           String?
  mediaUrl          String?          @map("media_url")
  authorId          String?          @map("author_id")
  author            User?            @relation("SentMessages", fields: [authorId], references: [id], onDelete: SetNull)
  isInternal        Boolean          @default(false) @map("is_internal")  // nota interna — não enviada ao cliente (T3.3)
  providerMessageId String?               @map("provider_message_id")
  deliveryStatus    MessageDeliveryStatus? @map("delivery_status")
  deliveryErrorCode Int?                  @map("delivery_error_code")
  createdAt         DateTime              @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([conversationId, isInternal])
  @@index([providerMessageId])
  @@map("messages")
}

// ============================================================
// Fluxo de atendimento (bot de boas-vindas + direcionamento)
// ============================================================

model Workflow {
  id                   String         @id @default(uuid())
  companyId            String         @map("company_id")
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enabled              Boolean        @default(false)
  welcomeMessage       String?        @map("welcome_message")
  fallbackDepartmentId String?        @map("fallback_department_id")
  fallbackDepartment   Department?    @relation("WorkflowFallbackDepartment", fields: [fallbackDepartmentId], references: [id], onDelete: SetNull)
  rules                WorkflowRule[]
  flowNodes            Json?          @map("flow_nodes")
  flowEdges            Json?          @map("flow_edges")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@unique([companyId])
  @@index([companyId])
  @@map("workflows")
}

model WorkflowRule {
  id           String     @id @default(uuid())
  workflowId   String     @map("workflow_id")
  workflow     Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position     Int
  optionLabel  String     @map("option_label")
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([workflowId])
  @@index([departmentId])
  @@map("workflow_rules")
}

model RolePermission {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      UserRole
  resource  String
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, role, resource, action])
  @@index([companyId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource  String
  action    String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, resource, action])
  @@index([userId])
  @@map("user_permission_overrides")
}

// ============================================================
// Log de atividade — auditoria de ações do sistema
// ============================================================
// Não está em TENANT_SCOPED_MODELS: companyId é sempre passado
// explicitamente pelo logger (que roda com isPlatform: true).
// ============================================================

model ActivityLog {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  userId       String?  @map("user_id")
  userName     String?  @map("user_name")
  action       String
  entity       String?
  entityId     String?  @map("entity_id")
  details      Json?
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  ip           String?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId])
  @@map("activity_logs")
}

// ============================================================
// Sessões Baileys — persistência do estado de autenticação
// WhatsApp no PostgreSQL (substitui disco local .baileys-sessions)
// ============================================================
// Não é tenant-scoped: acesso via Worker com isPlatform: true.
// instanceId mapeia para WhatsAppInstance.id.
// ============================================================

model BaileySession {
  id         String            @id @default(uuid())
  instanceId String            @unique @map("instance_id")
  creds      Json?
  updatedAt  DateTime          @updatedAt @map("updated_at")
  keys       BaileySessionKey[]

  @@map("bailey_sessions")
}

model BaileySessionKey {
  id        String        @id @default(uuid())
  sessionId String        @map("session_id")
  session   BaileySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  keyType   String        @map("key_type")
  keyId     String        @map("key_id")
  value     Json

  @@unique([sessionId, keyType, keyId])
  @@index([sessionId])
  @@map("bailey_session_keys")
}

// ============================================================
// CRM de plataforma — contratos, instalações e suporte
// Gerenciados pelo Super Admin, não pelo tenant.
// @@map usa snake_case; companyId é FK direta (sem auto-scope).
// ============================================================

model ClientContract {
  id                String          @id @default(uuid())
  companyId         String          @map("company_id")
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan              String
  status            ContractStatus  @default(TRIAL)
  value             Decimal?        @db.Decimal(10, 2)
  billingCycle      BillingCycle    @default(MONTHLY) @map("billing_cycle")
  startDate         DateTime        @map("start_date")
  endDate           DateTime?       @map("end_date")
  notes             String?
  signatureStatus   SignatureStatus  @default(PENDING) @map("signature_status")
  signedAt          DateTime?       @map("signed_at")
  signerName        String?         @map("signer_name")
  signatureData     String?         @db.Text @map("signature_data")
  pdfPath           String?         @map("pdf_path")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("client_contracts")
}

model Installation {
  id         String             @id @default(uuid())
  companyId  String             @map("company_id")
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  location   String?
  version    String?
  status     InstallationStatus @default(PENDING)
  lastSyncAt DateTime?          @map("last_sync_at")
  notes      String?
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("installations")
}

model SupportTicket {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        TicketType     @default(OTHER)
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  title       String
  description String
  resolvedAt  DateTime?      @map("resolved_at")
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@map("support_tickets")
}

// ============================================================
// T5.1 — Respostas rápidas (canned responses)
// Atalhos de texto pré-definidos para acelerar atendimento.
// @@map snake_case; companyId sem auto-scope (registradas com isPlatform:true).
// ============================================================

model SavedReply {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String                          // nome curto / atalho
  content   String   @db.Text              // texto completo da resposta
  tags      String[] @default([])           // categorias (ex: ["saudação","cobrança"])
  createdBy String?  @map("created_by")    // userId
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("saved_replies")
}

// ============================================================
// T6.1 — Automação de roteamento (rule-based routing)
// T6.3 — SLA por nível de prioridade
// ============================================================

model AutomationRule {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean  @default(true)
  priority    Int      @default(0)        // menor número = executada primeiro
  trigger     String                      // "conversation_created" | "message_received" | "idle"
  conditions  Json     @default("[]")     // [{field, operator, value}]
  actions     Json     @default("[]")     // [{type, params}] e.g. assign, set_priority, add_tag, close
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([companyId, enabled])
  @@index([companyId, trigger])
  @@map("automation_rules")
}

model SlaPolicy {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priority        String   @default("MEDIUM")   // LOW | MEDIUM | HIGH | URGENT
  firstResponseMin Int     @map("first_response_min")   // SLA em minutos para primeira resposta
  resolutionMin   Int      @map("resolution_min")       // SLA em minutos para resolução
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([companyId, priority])
  @@index([companyId])
  @@map("sla_policies")
}

// ============================================================
// T6.4: Mensagens agendadas
// Processadas a cada 1 minuto pelo scheduled-message-worker.
// ============================================================

model ScheduledMessage {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId String   @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdById    String   @map("created_by_id")
  createdBy      User     @relation(fields: [createdById], references: [id])
  content        String
  mediaUrl       String?  @map("media_url")
  mediaType      String?  @map("media_type")
  scheduledAt    DateTime @map("scheduled_at")
  sentAt         DateTime? @map("sent_at")
  status         String   @default("PENDING") // PENDING | SENT | FAILED | CANCELLED
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([status, scheduledAt])
  @@index([companyId, conversationId])
  @@map("scheduled_messages")
}

// ============================================================
// Templates HSM — cache local dos templates Meta aprovados
// Sincronizados diariamente via BullMQ scheduled job.
// companyId permite filtro rápido sem join.
// ============================================================

model Template {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instanceId      String   @map("instance_id")
  instance        WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  providerId      String   @map("provider_id")        // ID do template no Meta Graph API
  name            String
  language        String
  category        String                               // UTILITY | MARKETING | AUTHENTICATION
  status          String   @default("PENDING")         // APPROVED | REJECTED | PAUSED | PENDING | DISABLED
  quality         String?                              // GREEN | YELLOW | RED (atualizado via webhook)
  components      Json     @default("[]")
  rejectionReason String?  @map("rejection_reason")
  syncedAt        DateTime @default(now()) @map("synced_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  campaigns       Campaign[]

  @@unique([instanceId, providerId])
  @@unique([instanceId, name, language])
  @@index([companyId])
  @@index([instanceId, status])
  @@map("templates")
}

// ============================================================
// Phase 7 — Marketing Campaigns
// T7.1: Campaign + audience builder
// T7.2: Broadcast sending (bulk template messages)
// T7.3: Campaign analytics
// ============================================================

model Campaign {
  id              String           @id @default(uuid())
  companyId       String           @map("company_id")
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instanceId      String           @map("instance_id")
  instance        WhatsAppInstance @relation(fields: [instanceId], references: [id])
  createdById     String           @map("created_by_id")
  createdBy       User             @relation("CreatedCampaigns", fields: [createdById], references: [id])
  name            String
  status          String           @default("DRAFT") // DRAFT | SCHEDULED | RUNNING | PAUSED | COMPLETED | CANCELLED
  templateId      String?          @map("template_id")
  template        Template?        @relation(fields: [templateId], references: [id])
  audienceFilter  Json             @default("{}") @map("audience_filter")  // { tags?, contactIds?, segment? }
  templateParams  Json             @default("{}") @map("template_params")  // variable substitution map
  scheduledAt     DateTime?        @map("scheduled_at")
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  // T7.3: Aggregate analytics
  totalCount      Int              @default(0) @map("total_count")
  sentCount       Int              @default(0) @map("sent_count")
  deliveredCount  Int              @default(0) @map("delivered_count")
  readCount       Int              @default(0) @map("read_count")
  failedCount     Int              @default(0) @map("failed_count")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  recipients      CampaignRecipient[]

  @@index([companyId, status])
  @@index([companyId, scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id           String    @id @default(uuid())
  campaignId   String    @map("campaign_id")
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId    String    @map("contact_id")
  contact      Contact   @relation(fields: [contactId], references: [id])
  phone        String
  status       String    @default("PENDING") // PENDING | SENT | DELIVERED | READ | FAILED | SKIPPED
  messageId    String?   @map("message_id")  // Evolution/Meta message ID for status tracking
  errorMessage String?   @map("error_message")
  sentAt       DateTime? @map("sent_at")
  deliveredAt  DateTime? @map("delivered_at")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ============================================================
// Phase 8 — AI Features
// T8.1: Reply suggestions, T8.2: Categorization
// T8.3: Sentiment, T8.4: Conversation summaries
// ============================================================

model AiConversationMeta {
  id               String      @id @default(uuid())
  conversationId   String      @unique @map("conversation_id")
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentiment        String?     // positive | neutral | negative
  sentimentScore   Float?      @map("sentiment_score")
  category         String?     // billing | support | sales | complaint | other
  summary          String?     @db.Text
  suggestedReplies Json        @default("[]") @map("suggested_replies")  // string[]
  lastProcessedAt  DateTime?   @map("last_processed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([conversationId])
  @@map("ai_conversation_meta")
}

// ============================================================
// Phase 10 — SaaS / Billing
// T10.1: Usage metering, T10.2: Plan limits, T10.3: Billing
// ============================================================

model Plan {
  id                  String    @id @default(uuid())
  name                String    @unique                  // free | starter | professional | enterprise
  displayName         String    @map("display_name")
  priceMonthly        Float     @default(0) @map("price_monthly")  // BRL
  maxAgents           Int       @default(3) @map("max_agents")
  maxInstances        Int       @default(1) @map("max_instances")
  maxConversationsPerMonth Int  @default(500) @map("max_conversations_per_month")
  maxCampaignsPerMonth Int      @default(0) @map("max_campaigns_per_month")
  aiEnabled           Boolean   @default(false) @map("ai_enabled")
  analyticsEnabled    Boolean   @default(false) @map("analytics_enabled")
  createdAt           DateTime  @default(now()) @map("created_at")
  subscriptions       Subscription[]

  @@map("plans")
}

model Subscription {
  id             String    @id @default(uuid())
  companyId      String    @unique @map("company_id")
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId         String    @map("plan_id")
  plan           Plan      @relation(fields: [planId], references: [id])
  status         String    @default("ACTIVE")  // ACTIVE | CANCELLED | PAST_DUE | TRIALING
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  externalId     String?   @map("external_id")  // Stripe subscription ID
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("subscriptions")
}

model UsageMeter {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period       String                         // "2026-08" (YYYY-MM)
  conversations Int     @default(0)
  campaigns    Int      @default(0)
  aiCalls      Int      @default(0) @map("ai_calls")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([companyId, period])
  @@index([companyId, period])
  @@map("usage_meters")
}
