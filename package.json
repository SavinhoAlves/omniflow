{
  "name": "omnichannel-saas",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "npm run generate --workspace=packages/database",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:platform": "npm run dev --workspace=apps/platform",
    "dev:workers": "npm run dev --workspace=apps/workers"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
