# Redis (BullMQ - filas entre API e Workers)
REDIS_URL="redis://localhost:6379"

# Postgres (para módulos futuros que o worker também precisar consultar)
# Com Docker (docker compose up -d): usar o role omnichannel_app criado pelo init.sql
DATABASE_URL="postgresql://omnichannel_app:omnichannel_dev@localhost:5433/omnichannel?schema=public"

NODE_ENV=development
